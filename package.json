{
  "name": "simply-beautiful",
  "version": "1.0.2",
  "description": "Beautify HTML, JS, CSS, and JSON in the browser or in Node.js!",
  "main": "dist/index.js",
  "scripts": {
    "test": "npm run prepare && mocha test/ --recursive --timeout=10000",
    "prepare": "node -e \"require('prepare-package')()\"",
    "prepare:watch": "node -e \"require('prepare-package/watch')()\""
  },
  "engines": {
    "node": ">=12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itw-creative-works/simply-beautiful"
  },
  "keywords": [
    "beautify",
    "beautify-js",
    "beautify-json",
    "pretty-print",
    "pretty",
    "prettify",
    "beautify-css",
    "beautify-html",
    "html",
    "json",
    "css",
    "js",
    "javascript"
  ],
  "author": "ITW Creative Works",
  "license": "MIT",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/itw-creative-works/simply-beautiful/issues"
  },
  "homepage": "https://itwcreativeworks.com",
  "preparePackage": {
    "input": "./src",
    "output": "./dist",
    "replace": {},
    "type": "copy",
    "hooks": {}
  },
  "dependencies": {
    "itwcw-package-analytics": "^1.0.8"
  },
  "devDependencies": {
    "mocha": "^11.7.6",
    "prepare-package": "^2.1.0"
  }
}
